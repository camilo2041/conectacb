# Copiar a .env (Docker) o .env.local (desarrollo) y completar.

# Dominio que Traefik enruta a este contenedor.
DOMAIN_NAME=conectacb.autonomiaydesarrollo.com

# Google Maps (opcional). Sin llave, el mapa usa OpenStreetMap.
# Restringir la llave por referente HTTP a https://conectacb.autonomiaydesarrollo.com/* en Google Cloud Console.
VITE_GOOGLE_MAPS_API_KEY=
# Map ID de Google Cloud para estilos personalizados (por defecto DEMO_MAP_ID).
VITE_GOOGLE_MAPS_MAP_ID=
